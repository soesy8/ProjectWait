<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="OutlineRendererSetupWindow.uss" />
    <ui:VisualElement class="panel">
        <ui:Label text="강조 세팅" class="title" />
        <ui:Label text="현재 씬의 URP 렌더러를 찾아 마스크 실루엣 피처와 셰이더를 연결합니다." class="description" />
        <ui:Button name="detect" text="현재 씬 자동 감지" />
        <ui:Foldout text="고급 설정" value="false">
            <uie:ObjectField name="pipeline" label="사용할 URP 자산" />
            <ui:Toggle name="connectScene" label="현재 씬 연결 및 저장" value="true" />
            <ui:Label text="M 밖의 자산은 Assets/M/Arts/Rendering/AutoOutline 안에 복사합니다. 씬을 연결하면 Play Mode에서 해당 설정을 사용합니다." class="description" />
        </ui:Foldout>
        <ui:Button name="install" text="자동 설정" class="primary" />
        <ui:Label name="status" class="status" />
        <ui:Button name="inspect" text="설정 상태 다시 확인" />
        <ui:Label text="Unity 6 · URP · Render Graph용" class="description" />
    </ui:VisualElement>
</ui:UXML>
