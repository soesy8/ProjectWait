--- !u!114 &1481293410
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1481293409}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c6d010fabcc4427ad9cce00ad887c51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectWait.YB.OfficeBlackout.OfficeBlackoutCinematicOverlay
  playerCamera: {fileID: 1934594292}
  distanceFromCamera: 0.45
  playerMovement: {fileID: 1876543210987654321}
  panelMaterial: {fileID: 2100000, guid: 4c438ee3d1a2bfc4f9f72df927e1c264, type: 2}
  captionMaterial: {fileID: 2100000, guid: b4dc2a948e9cfeb45be547391080d2a7, type: 2}
  captionFont: {fileID: 11400000, guid: 693e250e9fc014d46a64ef7eb19087b1, type: 2}
  presentation: {fileID: 34710436}
  letterboxDuration: 0.38
  fadeDuration: 0.35
  clearCaptionWhenHidden: 1
  dialogues:
  - title: "\uC815\uC804"
    lines:
    - "\uCE5C\uAD6C: \uC5B4? \uBD88\uC774 \uAC11\uC790\uAE30 \uAEBC\uC84C\uC5B4!
      \uBB34\uC11C\uC6CC\u2026"
    - "\uC548\uB0B4: \uC5B4\uB450\uC6B8 \uB54C\uB294 \uC11C\uB458\uB7EC \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uC544\uC694.\n\uC606\uC5D0 \uC788\uB294 \uCE5C\uAD6C\uB97C \uBA3C\uC800
      \uC548\uC2EC\uC2DC\uCF1C \uBCFC\uAE4C\uC694?"
  - title: "\uC548\uC2EC"
    lines:
    - "\uB098: \uAD1C\uCC2E\uC544. \uB0B4\uAC00 \uC606\uC5D0 \uC788\uC5B4."
    - "\uCE5C\uAD6C: \uACE0\uB9C8\uC6CC. \uAC19\uC774 \uC788\uC73C\uB2C8\uAE4C \uC870\uAE08
      \uC548\uC2EC\uB3FC.\n\uBB38 \uCABD\uC73C\uB85C \uAC00 \uBCFC\uAE4C?"
  - title: "\uAE30\uB2E4\uB9AC\uAE30"
    lines:
    - "\uB098: \uC5B4\uB450\uC6B0\uBA74 \uAC00\uAD6C\uC5D0 \uBD80\uB52A\uD790 \uC218
      \uC788\uC5B4.\n\uC5EC\uAE30\uC11C \uD568\uAED8 \uC120\uC0DD\uB2D8\uC744 \uAE30\uB2E4\uB9AC\uC790."
    - "\uCE5C\uAD6C: \uC751, \uD63C\uC790 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uACE0 \uAC19\uC774
      \uAE30\uB2E4\uB9B4\uAC8C."
  - title: "\uAD50\uC0AC \uBAA9\uC18C\uB9AC"
    lines:
    - "\uC120\uC0DD\uB2D8: \uAD50\uBB34\uC2E4\uC5D0 \uC788\uB2C8? \uC120\uC0DD\uB2D8\uC774
      \uAC00\uACE0 \uC788\uC5B4.\n\uADF8 \uC790\uB9AC\uC5D0\uC11C \uD568\uAED8 \uAE30\uB2E4\uB824
      \uC8FC\uB834."
  - title: "\uAD50\uC0AC \uB3C4\uCC29"
    lines:
    - "\uC120\uC0DD\uB2D8: \uCE5C\uAD6C\uC640 \uD568\uAED8 \uCE68\uCC29\uD558\uAC8C
      \uAE30\uB2E4\uB838\uAD6C\uB098.\n\uC120\uC0DD\uB2D8\uC774 \uC548\uC804\uD55C
      \uAE38\uC744 \uD655\uC778\uD588\uC5B4."
    - "\uC120\uC0DD\uB2D8: \uC774\uC81C \uC120\uC0DD\uB2D8\uC758 \uC548\uB0B4\uB97C
      \uB530\uB77C \uD568\uAED8 \uB098\uAC00\uC790.\n\uC900\uBE44\uAC00 \uB418\uBA74
      \u2018\uD568\uAED8 \uC774\uB3D9\uD558\uAE30\u2019\uB97C \uC120\uD0DD\uD558\uB834."
  - title: "\uCD9C\uAD6C \uB3C4\uCC29"
    lines:
    - "\uC120\uC0DD\uB2D8: \uC798\uD588\uC5B4. \uC5B4\uB450\uC6B8 \uB54C \uD63C\uC790
      \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uACE0,\n\uCE5C\uAD6C\uC640 \uAE30\uB2E4\uB9B0
      \uB4A4 \uC548\uB0B4\uC5D0 \uB530\uB77C \uC774\uB3D9\uD588\uAD6C\uB098."
  - title: "\uB3C4\uC785"
    lines:
    - "\uB098: \uC120\uC0DD\uB2D8\uAED8 \uBD80\uD0C1\uBC1B\uC740 \uC11C\uB958\uB97C
      \uAC00\uC838\uC654\uC5B4.\n\uCC45\uC0C1 \uC704\uC5D0 \uB193\uC544 \uB450\uC790."
  captionIntervalSeconds: 3.5
  showLetterboxForSequence: 1
  hideLetterboxWhenSequenceEnds: 1
  onCaptionSequenceCompleted:
    m_PersistentCalls:
      m_Calls: []
  onFadeToBlackCompleted:
